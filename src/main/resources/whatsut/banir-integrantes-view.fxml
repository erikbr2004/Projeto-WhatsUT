<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="whatsut.controllers.BanirIntegrantesController"
            prefWidth="350" prefHeight="300">

    <VBox spacing="10" layoutX="20" layoutY="20" AnchorPane.topAnchor="10" AnchorPane.bottomAnchor="10"
          AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10">

        <Label text="Selecione os integrantes para banir:" />

        <ListView fx:id="listCheck" prefHeight="200" />

        <Button text="Banir Selecionados" onAction="#banirSelecionados" />
    </VBox>
</AnchorPane>
